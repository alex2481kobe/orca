{
  "name": "orca",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "Local-first MCP control plane for orchestrating fleets of Codex, Claude, CLI, and API-backed coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex2481kobe/orca.git"
  },
  "bugs": {
    "url": "https://github.com/alex2481kobe/orca/issues"
  },
  "homepage": "https://github.com/alex2481kobe/orca#readme",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "orca-mcp": "src/mcp-server.js"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "test": "ORCA_AUTO_AUDIT=false node --test --test-concurrency=1 ./test/**/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "node scripts/smoke.mjs",
    "smoke:full-flow": "node scripts/smoke.mjs",
    "smoke:security": "node scripts/smoke.mjs",
    "smoke:ssrf": "node scripts/ssrf-smoke.mjs",
    "smoke:no-hardcoded-colors": "node scripts/verify-no-hardcoded-colors.mjs",
    "smoke:security-headers": "node scripts/security-headers-smoke.mjs",
    "smoke:streams": "node scripts/streams-smoke.mjs",
    "smoke:private-access": "node scripts/private-access-smoke.mjs",
    "smoke:mcp-flow": "node scripts/mcp-flow-smoke.mjs",
    "smoke:mcp-cli-handshake": "node scripts/mcp-cli-handshake-smoke.mjs",
    "smoke:real-executor": "node scripts/real-executor-smoke.mjs",
    "smoke:pwa-cache": "node scripts/pwa-cache-smoke.mjs",
    "smoke:providers": "node scripts/provider-smoke.mjs",
    "smoke:api-provider": "node scripts/api-provider-smoke.mjs",
    "smoke:notifications": "node scripts/notifications-smoke.mjs",
    "smoke:state-migrations": "node scripts/state-migrations-smoke.mjs",
    "smoke:auth-sessions": "node scripts/auth-sessions-smoke.mjs",
    "smoke:orchestrator-executor": "node scripts/orchestrator-executor-smoke.mjs",
    "smoke:credential-backends": "node scripts/credential-backends-smoke.mjs",
    "smoke:credential-redaction": "node scripts/credential-redaction-smoke.mjs",
    "smoke:process-lifecycle": "node scripts/process-lifecycle-smoke.mjs",
    "operator:status": "node scripts/operator-status.mjs",
    "operator:pair": "node scripts/operator-pairing-code.mjs",
    "operator:phone-check": "node scripts/operator-phone-check.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:imports": "node scripts/typecheck-imports.mjs",
    "smoke:orchestrator-lifecycle": "node scripts/orchestrator-lifecycle-smoke.mjs",
    "smoke:lane-detail-arch": "node scripts/verify-lane-detail-arch.mjs",
    "smoke:lane-stream": "node scripts/verify-lane-stream.mjs",
    "assets:version": "node scripts/sync-asset-version.mjs",
    "assets:shots": "node scripts/capture-readme-shots.mjs",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "playwright": "1.60.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@xterm/xterm": "6.0.0"
  }
}
