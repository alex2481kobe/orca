// Editor/IDE type-check config only. There is deliberately NO `npm run typecheck`
// script: a full `tsc --noEmit` over this codebase reports hundreds of false
// TS2551s, because methods added to OrcaRegistry via Object.assign(prototype,
// mixin) are invisible to checkJs. The REAL gate is `npm run typecheck:imports`
// (scripts/typecheck-imports.mjs), which catches the high-value bug class —
// undefined names and broken imports — and is what CI runs.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "public/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "artifacts", ".orca", "test"]
}
